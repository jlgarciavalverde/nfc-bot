{
  "name": "nfc-bot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "dev:bot": "pnpm --filter @nfc/bot dev",
    "dev:api": "pnpm --filter @nfc/api dev",
    "dev:web": "pnpm --filter @nfc/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "e2e": "playwright test"
  }
}
