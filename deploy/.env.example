# ~/servicios/nfc/.env en el VPS (permisos 600). Los secretos se escriben con `read -rsp`, nunca pegándolos en un chat.
POSTGRES_PASSWORD=        # lo genera tools/deploy.mjs la primera vez
SETUP_CODE=               # lo genera tools/deploy.mjs; sirve para /start <código> del primer admin
BOT_TOKEN=                # el de @BotFather
GEMINI_API_KEY=           # opcional: sin ella el bot solo entiende comandos
PUBLIC_URL=https://nfc.redgarverde.com
APP_VERSION=0.1.0
