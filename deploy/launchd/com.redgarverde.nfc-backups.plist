<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Plantilla: tools/install-launchd.sh sustituye __REPO__ y __HOME__ y la copia a ~/Library/LaunchAgents/ -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.redgarverde.nfc-backups</string>
  <key>ProgramArguments</key><array><string>/bin/sh</string><string>__REPO__/tools/pull-backups.sh</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>5</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Backups/nfc-bot/backups.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Backups/nfc-bot/backups.log</string>
</dict>
</plist>
